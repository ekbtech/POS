DATABASE_URL=mysql://pos_user:change-this-password@localhost:3306/ivans_pos
POS_ADMIN_EMAIL=admin@checonex.co.ke
POS_ADMIN_PASSWORD=replace-with-a-long-random-password

# Daraja sandbox only. Put real values in ignored .env.local, never here.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-ngrok-domain.ngrok-free.app/api/payments/mpesa/callback

# Set to 1 for one startup to import data/store.json into MySQL.
# Remove or set to 0 after the import has completed.
POS_IMPORT_LEGACY_JSON=0
